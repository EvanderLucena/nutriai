# PostgreSQL
POSTGRES_DB=nutriai
POSTGRES_USER=nutriai
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Backend
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nutriai
SPRING_DATASOURCE_USERNAME=nutriai
SPRING_DATASOURCE_PASSWORD=changeme
SERVER_PORT=8080

# Redis
REDIS_PASSWORD=nutriai-redis-dev-password

# JWT
NUTRIAI_JWT_SECRET=ci-dev-secret-minimum-32-chars-ok!
NUTRIAI_SEED_ADMIN_PASSWORD=admin123

# LLM (Ollama Cloud or Local)
# For Cloud: https://api.ollama.com/v1 + your API key
# For Local: http://localhost:11434/v1 + no key
NUTRIAI_LLM_BASE_URL=https://api.ollama.com/v1
NUTRIAI_LLM_MODEL=glm4
NUTRIAI_LLM_API_KEY=

# Evolution Go (WhatsApp Gateway)
# Generate a secure GLOBAL_API_KEY for Evolution Go
EVOLUTION_API_KEY=your-secure-evolution-global-api-key-here
EVOLUTION_API_URL=http://localhost:8081
# Evolution Go forwards events to this URL. For local dev, use ngrok.
# Example: EVOLUTION_WEBHOOK_URL=https://abcd.ngrok.io/api/v1/webhooks/whatsapp
EVOLUTION_WEBHOOK_URL=

# Frontend
VITE_API_URL=http://localhost:8080
VITE_PORT=5173
